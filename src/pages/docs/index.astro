---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;
const entries = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Docs — agistra.dev" description="Quickstart and setup guidance for agistra.dev.">
	<section class="container docs">
		<h1 class="docs__heading">Docs</h1>
		<p class="docs__intro">Quickstart and setup guidance. More is on the way.</p>

		{
			entries.length === 0 ? (
				<p class="docs__empty">No docs published yet — check back soon.</p>
			) : (
				<ul class="docs__list">
					{entries.map((entry) => (
						<li class="docs__item">
							<a class="docs__link" href={`${base}docs/${entry.slug}/`}>
								{entry.data.title}
							</a>
							<p class="docs__desc">{entry.data.description}</p>
						</li>
					))}
				</ul>
			)
		}
	</section>

	<style>
		.docs {
			max-width: var(--content-width);
			padding-block: var(--space-16);
		}

		.docs__heading {
			font-size: var(--text-4xl);
			margin-bottom: var(--space-3);
		}

		.docs__intro {
			color: var(--color-text-muted);
			margin-bottom: var(--space-8);
		}

		.docs__empty {
			color: var(--color-text-muted);
			font-family: var(--font-mono);
		}

		.docs__list {
			list-style: none;
			display: flex;
			flex-direction: column;
			gap: var(--space-6);
		}

		.docs__item {
			border: 1px solid var(--color-border);
			border-radius: var(--radius);
			padding: var(--space-5);
			background: var(--color-surface);
		}

		.docs__link {
			font-family: var(--font-display);
			font-weight: 600;
			font-size: var(--text-lg);
			color: var(--color-heading);
			text-decoration: none;
		}

		.docs__link:hover {
			color: var(--color-accent);
		}

		.docs__desc {
			color: var(--color-text-muted);
			font-size: var(--text-sm);
			margin-top: var(--space-2);
		}
	</style>
</Layout>
