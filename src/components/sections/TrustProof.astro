---
import { SITE } from '../../data/site';
---

<section class="trust" aria-labelledby="trust-heading">
	<div class="container trust__inner">
		<h2 id="trust-heading" class="trust__heading">We build our own sites with it.</h2>
		<p class="trust__body">
			<a href="https://vladsetchin.me" target="_blank" rel="noopener noreferrer"
				>vladsetchin.me</a
			> was planned and built end-to-end through Agistra's own ticket workflow — GitHub issues,
			task files, feature branches, and PRs, running through the same Architect → Builder →
			Tester lifecycle described above.
		</p>
		<p class="trust__body">
			<strong>agistra.dev-web</strong> — the site you're looking at right now — and the future
			<code>agistra.com.au</code> are being built the exact same way.
		</p>
		<p class="trust__footnote">
			No invented stats, no fabricated testimonials — this page is its own proof.
			<a href={SITE.github} target="_blank" rel="noopener noreferrer">See the source ↗</a>
		</p>
	</div>
</section>

<style>
	.trust {
		padding-block: var(--space-16);
		border-top: 1px solid var(--color-border);
	}

	.trust__inner {
		max-width: var(--content-width);
	}

	.trust__heading {
		font-size: var(--text-2xl);
		margin-bottom: var(--space-6);
	}

	.trust__body {
		color: var(--color-text-muted);
		margin-bottom: var(--space-4);
		max-width: 640px;
	}

	.trust__body a,
	.trust__body code {
		color: var(--color-text);
	}

	.trust__body code {
		background: var(--color-surface);
		padding: 0.1em 0.4em;
		border-radius: var(--radius-sm);
		font-size: 0.9em;
	}

	.trust__footnote {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		color: var(--color-text-muted);
	}

	.trust__footnote a {
		color: var(--color-accent);
	}
</style>
