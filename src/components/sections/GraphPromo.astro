<section class="graph-promo" aria-label="Graph">
	<div class="container graph-promo__inner">
		<p class="graph-promo__body">
			agistra.dev is free and open-source. Graph adds a map of your code, so the agents can
			tell you who calls what and what a change will break.
			<a href="https://agistra.ai/pricing" target="_blank" rel="noopener noreferrer"
				>Get Graph on agistra.ai</a
			><span aria-hidden="true"> ↗</span>
		</p>
	</div>
</section>

<style>
	.graph-promo {
		padding-block: var(--space-16);
		border-top: 1px solid var(--color-border);
	}

	.graph-promo__inner {
		max-width: var(--content-width);
	}

	.graph-promo__body {
		color: var(--color-text-muted);
		max-width: 640px;
	}

	.graph-promo__body a {
		color: var(--color-text);
	}
</style>
