---
import '../styles/global.css';
import { SITE } from '../data/site';
import NavToggle from '../components/NavToggle';
import Footer from '../components/Footer.astro';

export interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
}

const {
	title = SITE.title,
	description = SITE.description,
	noindex = false,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const navLinks = [
	{ href: `${base}docs/`, label: 'Docs' },
	{ href: SITE.github, label: 'GitHub', external: true },
];

// The handoff rail (see global.css token comment) is the homepage's
// signature element — a page-length line threading through the four agent
// role colors in lifecycle order. It reads as noise on utility pages (docs,
// 404), so it only renders on the homepage.
const isHome = Astro.url.pathname === base;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500..600;1,9..144,500..600&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		{noindex && <meta name="robots" content="noindex,nofollow" />}

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
	</head>
	<body>
		<a href="#main" class="skip-link">Skip to main content</a>

		<header class="site-header">
			<nav class="container nav" aria-label="Main navigation">
				<a href={base} class="nav__brand" aria-label="agistra.dev — home">
					agistra<span class="nav__brand-dim">.</span>dev
				</a>
				<NavToggle client:load links={navLinks} />
			</nav>
		</header>

		<main id="main" class="site-main">
			{
				isHome && (
					<div class="page-rail" aria-hidden="true">
						<span class="page-rail__tick" style="--tick-color: var(--role-architect); --tick-pos: 6%" />
						<span class="page-rail__tick" style="--tick-color: var(--role-builder); --tick-pos: 34%" />
						<span class="page-rail__tick" style="--tick-color: var(--role-tester); --tick-pos: 62%" />
						<span class="page-rail__tick" style="--tick-color: var(--role-router); --tick-pos: 90%" />
					</div>
				)
			}
			<slot />
		</main>

		<footer class="site-footer">
			<div class="container">
				<Footer />
			</div>
		</footer>

		<style>
			.site-header {
				position: sticky;
				top: 0;
				z-index: 50;
				background: rgba(23, 19, 31, 0.85);
				border-bottom: 1px solid var(--color-border);
				backdrop-filter: blur(8px);
				-webkit-backdrop-filter: blur(8px);
			}

			.nav {
				display: flex;
				justify-content: space-between;
				align-items: center;
				padding-block: var(--space-4);
			}

			.nav__brand {
				font-family: var(--font-mono);
				font-weight: 600;
				font-size: var(--text-lg);
				color: var(--color-heading);
				text-decoration: none;
				letter-spacing: -0.01em;
			}

			.nav__brand-dim {
				color: var(--color-nav);
			}

			.nav__brand:hover {
				opacity: 0.85;
			}

			:global(.nav-toggle-wrap) {
				display: flex;
				align-items: center;
				position: relative;
			}

			:global(.nav__toggle) {
				display: none;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				gap: 4px;
				width: 36px;
				height: 36px;
				border: 1px solid var(--color-border);
				border-radius: var(--radius-sm);
				background: transparent;
			}

			:global(.nav__toggle-bar) {
				width: 16px;
				height: 2px;
				border-radius: 1px;
				background: var(--color-text);
			}

			:global(.nav__links) {
				display: flex;
				align-items: center;
				gap: var(--space-6);
			}

			:global(.nav__link) {
				color: var(--color-text-muted);
				font-size: var(--text-sm);
				font-weight: 500;
				text-decoration: none;
				transition: color 0.2s ease;
			}

			:global(.nav__link:hover) {
				color: var(--color-nav);
			}

			@media (max-width: 640px) {
				:global(.nav__toggle) {
					display: flex;
				}

				:global(.nav__links) {
					position: absolute;
					top: calc(100% + var(--space-4));
					right: 0;
					flex-direction: column;
					align-items: flex-end;
					gap: var(--space-3);
					background: var(--color-surface);
					border: 1px solid var(--color-border);
					border-radius: var(--radius);
					padding: var(--space-4);
					min-width: 160px;
					max-height: 0;
					overflow: hidden;
					opacity: 0;
					pointer-events: none;
					transition:
						max-height 0.2s ease,
						opacity 0.15s ease;
				}

				:global(.nav__links.is-open) {
					max-height: 200px;
					opacity: 1;
					pointer-events: auto;
				}
			}

			.site-main {
				flex: 1;
				position: relative;
			}

			/* Signature element: the handoff rail. A page-length vertical line in
			   the left gutter that threads through the four agent role colors in
			   lifecycle order (Architect -> Builder -> Tester -> Router) — a literal
			   picture of the ticket handoff that is the product's actual mechanic,
			   not a generic decorative accent. Homepage only (see isHome above);
			   purely decorative, so it is hidden from the accessibility tree and
			   ignores pointer events. Hidden below the tablet breakpoint, where the
			   roster cards' own role-colored top borders already carry the same
			   signal in the narrow column. */
			.page-rail {
				position: absolute;
				top: 0;
				bottom: 0;
				left: clamp(0.5rem, 2vw, 2rem);
				width: 2px;
				background: linear-gradient(
					to bottom,
					var(--role-architect),
					var(--role-builder),
					var(--role-tester),
					var(--role-router)
				);
				opacity: 0.55;
				pointer-events: none;
				z-index: 0;
			}

			.page-rail__tick {
				position: absolute;
				top: var(--tick-pos);
				left: 50%;
				width: 8px;
				height: 8px;
				border-radius: 50%;
				background: var(--tick-color);
				transform: translate(-50%, -50%);
				box-shadow: 0 0 0 4px var(--color-bg);
			}

			@media (max-width: 900px) {
				.page-rail {
					display: none;
				}
			}

			.site-footer {
				border-top: 1px solid var(--color-border);
				margin-top: var(--space-24);
				padding-block: var(--space-8);
			}
		</style>
	</body>
</html>
